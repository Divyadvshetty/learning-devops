7. Step 4 — Create the automated analysis script
We will create one script that automatically performs the analysis instead of manually running 25 different commands.

Run:
nano analyzer.sh


If Nano opens, paste the entire script below.
#!/bin/bash

LOG_FILE="file.txt"
REPORT="reports/analysis_report.txt"

if [ ! -f "$LOG_FILE" ]; then
    echo "Log file not found!"
    exit 1
fi

echo "===== SERVER LOG ANALYSIS =====" > "$REPORT"

echo "" >> "$REPORT"
echo "Total Requests:" >> "$REPORT"
awk 'END {print NR}' "$LOG_FILE" >> "$REPORT"

echo "" >> "$REPORT"
echo "Successful Requests (200):" >> "$REPORT"
awk '$4 == 200 {count++} END {print count+0}' "$LOG_FILE" >> "$REPORT"

echo "" >> "$REPORT"
echo "Failed Requests (400 and 500):" >> "$REPORT"
awk '$4 >= 400 {count++} END {print count+0}' "$LOG_FILE" >> "$REPORT"

echo "" >> "$REPORT"
echo "Error Status Summary:" >> "$REPORT"
awk '$4 >= 400 {count[$4]++} END {for (code in count) print code, count[code]}' "$LOG_FILE" >> "$REPORT"

echo "" >> "$REPORT"
echo "Top IP Addresses:" >> "$REPORT"
awk '{count[$1]++} END {for (ip in count) print count[ip], ip}' "$LOG_FILE" | sort -nr | head -5 >> "$REPORT"

echo "" >> "$REPORT"
echo "Failed Requests Details:" >> "$REPORT"
awk '$4 >= 400 {print $1, $3, $4}' "$LOG_FILE" >> "$REPORT"

echo "" >> "$REPORT"
echo "===== ANALYSIS COMPLETED =====" >> "$REPORT"

cat "$REPORT"


