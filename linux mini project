Step 2: Create the Automated Triage & Remediation Script

Save this complete script as scripts/incident_triage.sh. It executes your entire command list in a structured production workflow:
bash
cat << 'EOF' > scripts/incident_triage.sh
#!/usr/bin/env bash
set -euo pipefail

BASE_DIR="$HOME/linux-incident-triage-toolkit"
cd "$BASE_DIR"

REPORT_FILE="reports/incident_summary_$(date +%Y%m%d_%H%M%S).txt"

echo "==========================================" | tee "$REPORT_FILE"
echo " AUTOMATED LINUX INCIDENT TRIAGE REPORT   " | tee -a "$REPORT_FILE"
echo "==========================================" | tee -a "$REPORT_FILE"

# 1. Host & Dependency Discovery (uname, command -v, which, type)
echo -e "\n[1] SYSTEM & TOOLCHAIN VERIFICATION" | tee -a "$REPORT_FILE"
echo "Working Directory : $(pwd)" | tee -a "$REPORT_FILE"
echo "Kernel & Arch     : $(uname -srm)" | tee -a "$REPORT_FILE"

for tool in awk sed grep journalctl systemctl; do
  if command -v "$tool" >/dev/null 2>&1; then
    echo "Verified binary   : $(which "$tool") ($(type -t "$tool"))" | tee -a "$REPORT_FILE"
  else
    echo "CRITICAL: Missing required tool $tool" | tee -a "$REPORT_FILE"
    exit 1
  fi
done

# 2. File Integrity & Backup (ls, file, cp)
echo -e "\n[2] ARTIFACT INSPECTION & SAFE BACKUP" | tee -a "$REPORT_FILE"
ls -lh configs/ logs/ | tee -a "$REPORT_FILE"
echo "Config MIME check : $(file -b configs/payment-service.conf)" | tee -a "$REPORT_FILE"
echo "Log MIME check    : $(file -b logs/payment-app.log)" | tee -a "$REPORT_FILE"

cp configs/payment-service.conf backups/payment-service.conf.bak
echo "Backup created    : backups/payment-service.conf.bak" | tee -a "$REPORT_FILE"

# 3. Configuration Remediation (sed)
echo -e "\n[3] AUTOMATED CONFIG REMEDIATION" | tee -a "$REPORT_FILE"
sed -i 's/ENVIRONMENT=staging/ENVIRONMENT=production/g; s/LOG_LEVEL=DEBUG/LOG_LEVEL=ERROR/g; s|http://|https://|g' configs/payment-service.conf
cat configs/payment-service.conf | tee -a "$REPORT_FILE"

# 4. Application Log Parsing & Aggregation (grep, cut, tr, awk)
echo -e "\n[4] APPLICATION ERROR ANALYSIS" | tee -a "$REPORT_FILE"
ERROR_COUNT=$(grep -c "ERROR" logs/payment-app.log || true)
echo "Total ERROR events: $ERROR_COUNT" | tee -a "$REPORT_FILE"

echo "Impacted Users (uppercase normalized):" | tee -a "$REPORT_FILE"
grep "ERROR" logs/payment-app.log | cut -d'|' -f4 | cut -d'=' -f2 | tr -d ' ' | tr '[:lower:]' '[:upper:]' | sort -u | tee -a "$REPORT_FILE"

echo "Error Status Breakdown & Average Latency:" | tee -a "$REPORT_FILE"
awk -F'|' '/ERROR/ {
  gsub(/ /, "", $5);
  gsub(/latency=|ms/, "", $6);
  sum += $6; count++;
  print " -> " $1 " | " $3 " | " $5 " | " $6 "ms"
}
END {
  if (count > 0) printf "Average Error Latency: %.2f ms\n", sum/count
}' logs/payment-app.log | tee -a "$REPORT_FILE"

# 5. Systemd Service & Journal Audit (systemctl, journalctl)
echo -e "\n[5] SYSTEMD & JOURNALD HEALTH CHECK" | tee -a "$REPORT_FILE"
echo "Systemd State     : $(systemctl is-system-running || true)" | tee -a "$REPORT_FILE"
echo "Recent System Logs (Last 5 entries):" | tee -a "$REPORT_FILE"
journalctl -n 5 --no-pager | tee -a "$REPORT_FILE"

# 6. Workspace Cleanup (rm)
echo -e "\n[6] TEMPORARY ARTIFACT CLEANUP" | tee -a "$REPORT_FILE"
rm -fv logs/*.tmp | tee -a "$REPORT_FILE"

echo -e "\nTriage complete. Report saved to: $REPORT_FILE"
EOF

chmod +x scripts/incident_triage.sh
